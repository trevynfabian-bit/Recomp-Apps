# Salin berkas ini menjadi .env.local lalu isi dari dashboard Supabase
# (Project Settings → API). Pakai proyek yang SAMA dengan web Next.js.
#
# Prefix EXPO_PUBLIC_ berarti nilainya IKUT ter-bundle ke aplikasi.
# Karena itu hanya anon key yang boleh di sini — JANGAN pernah service-role key.
# Keamanan data bersandar pada RLS di database, bukan pada kerahasiaan anon key.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Secret Edge Function (BUKAN untuk aplikasi) ----------------------------
# Disetel lewat `supabase secrets set`, TIDAK ikut ter-bundle ke aplikasi dan
# tidak boleh diberi prefix EXPO_PUBLIC_.
#   ANTHROPIC_API_KEY   kunci provider untuk estimasi foto
#   ESTIMASI_MODEL      opsional, bawaan claude-opus-5
#   ESTIMASI_EFFORT     opsional, low|medium|high — bawaan medium demi biaya
